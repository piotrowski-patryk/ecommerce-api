model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  name       String
  quantity   Int      @default(1)
  currency   String   @default("PLN")
  priceNet   Decimal  @map("price_net") @db.Decimal(10, 2)
  priceGross Decimal  @map("price_gross") @db.Decimal(10, 2)
  vatRate    Int      @map("vat_rate")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  order      Order    @relation(fields: [orderId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@index([orderId], map: "order_items_order_id_fkey")
  @@index([productId], map: "order_items_product_id_fkey")
  @@map("order_items")
}
