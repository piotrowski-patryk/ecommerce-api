model Order {
  id       String @id @default(uuid())
  publicId Int    @unique @default(autoincrement()) @map("public_id")

  currency   String  @default("PLN")
  totalNet   Decimal @default(0.00) @map("total_net") @db.Decimal(10, 2)
  totalGross Decimal @default(0.00) @map("total_gross") @db.Decimal(10, 2)
  totalTax   Decimal @default(0.00) @map("total_tax") @db.Decimal(10, 2)
  totalPaid  Decimal @default(0.00) @map("total_paid") @db.Decimal(10, 2)
  status     String  @default("PENDING")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clients  OrderClient[]
  items    OrderItem[]
  payments Payment[]

  @@map("orders")
}

model OrderClient {
  id String @id @default(uuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  name  String
  email String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("order_clients")
}


model OrderItem {
  id String @id @default(uuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productVariantId String         @map("product_variant_id")
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  name       String
  quantity   Int     @default(1)
  currency   String  @default("PLN")
  priceNet   Decimal @map("price_net") @db.Decimal(10, 2)
  priceGross Decimal @map("price_gross") @db.Decimal(10, 2)
  vatRate    Int     @map("vat_rate")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("order_items")
}
