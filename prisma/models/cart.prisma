enum CartStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  ABANDONED
}

model Cart {
  id        String     @id @default(uuid())
  sessionId String?    @unique @map("session_id")

  status    CartStatus @default(ACTIVE)

  expiresAt DateTime   @default(dbgenerated("(CURRENT_TIMESTAMP + '30 days'::interval)")) @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  items     CartItem[]

  @@index([expiresAt], map: "carts_expires_at_idx")
  @@map("carts")
}
