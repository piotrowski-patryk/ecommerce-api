{
  "name": "ecommerce-api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "private": true,
  "author": "Patryk Piotrowski",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsx esbuild.config.ts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:email": "email dev --dir src/modules/mailer/templates",
    "dev:seed": "tsx prisma/seed/seed.ts",
    "test": "node --import tsx --test src/modules/products/mappers/product.mapper.test.ts src/modules/cart/mappers/cart-product.mapper.test.ts src/modules/cart/utils/cart-expiration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^8.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "^6.1.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.0",
    "esbuild": "^0.28.0",
    "prisma": "^7.8.0",
    "react-email": "^6.1.5",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xdellta/ecommerce-api.git"
  },
  "bugs": {
    "url": "https://github.com/Xdellta/ecommerce-api/issues"
  },
  "homepage": "https://github.com/Xdellta/ecommerce-api#readme"
}
